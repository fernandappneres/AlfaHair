{
  "name": "alfa-hair",
  "version": "1.0.0",
  "private": true,
  "description": "Site do salão Alfa Hair — mobile-first, leve e fácil de manter.",
  "scripts": {
    "build": "tailwindcss -i ./styles/input.css -o ./styles/output.css --minify",
    "dev": "tailwindcss -i ./styles/input.css -o ./styles/output.css --watch",
    "serve": "npx --yes http-server -c-1 -p 8080 ."
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
